# =========================
# Emporio - Git Ignore
# =========================

# Python
__pycache__/
*.py[cod]
*$py.class

# Python build / distribution
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Emporio local data
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3

# IDE / editors
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
